  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 6395939985891858365}
  buttonSound: {fileID: 8117556573048975872}
  zoomButton: {fileID: 0}
  staminaBar: {fileID: 0}
  gloveButton: {fileID: 0}
  lines:
  - "Get ready \u2014 the Punch Ball Run Grand Tournament is about to begin!"
  - "Punch those beach balls into the goal \u2014 but only with your boxing gloves!"
  - Competitors, ready your fists! Hit the glove button in the bottom left to gear
    up!
  - Once your glove is activated, use it to punch the ball!
  - "Careful! After each punch, your glove needs a short cooldown before it\u2019s
    ready again."
  - "Hit the yellow zone on the goal to earn bonus points \u2014 the faster your
    ball, the more you score!"
  - "Good luck! Use the zoom button to stay sharp \u2014 and watch out for obstacles!"
  textSpeed: 0.025
